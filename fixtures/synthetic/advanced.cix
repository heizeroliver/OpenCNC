; Synthetic advanced-operation fixture written for OpenCNC tests
BEGIN MAINDATA
	LPX=600
	LPY=300
	LPZ=18
END MAINDATA

BEGIN MACRO
	NAME=GEO
	PARAM,NAME=ID,VALUE="outline"
	PARAM,NAME=SIDE,VALUE=0
END MACRO
BEGIN MACRO
	NAME=START_POINT
	PARAM,NAME=X,VALUE=50
	PARAM,NAME=Y,VALUE=100
END MACRO
BEGIN MACRO
	NAME=ARC_EPCE
	PARAM,NAME=XE,VALUE=150
	PARAM,NAME=YE,VALUE=100
	PARAM,NAME=XC,VALUE=100
	PARAM,NAME=YC,VALUE=100
	PARAM,NAME=DIR,VALUE=CW
END MACRO
BEGIN MACRO
	NAME=LINE_EP
	PARAM,NAME=XE,VALUE=200
	PARAM,NAME=YE,VALUE=150
END MACRO
BEGIN MACRO
	NAME=ENDPATH
END MACRO

BEGIN MACRO
	NAME=ROUTG
	PARAM,NAME=ID,VALUE="route-outline"
	PARAM,NAME=GID,VALUE="outline"
	PARAM,NAME=SIDE,VALUE=0
	PARAM,NAME=DP,VALUE=6
	PARAM,NAME=DIA,VALUE=8
END MACRO

BEGIN MACRO
	NAME=PKT1
	PARAM,NAME=ID,VALUE="pocket-outline"
	PARAM,NAME=GID,VALUE="outline"
	PARAM,NAME=SIDE,VALUE=0
	PARAM,NAME=DP,VALUE=4
	PARAM,NAME=DIA,VALUE=10
END MACRO

BEGIN MACRO
	NAME=CUT_X
	PARAM,NAME=ID,VALUE="crosscut"
	PARAM,NAME=SIDE,VALUE=0
	PARAM,NAME=X,VALUE=25
	PARAM,NAME=Y,VALUE=250
	PARAM,NAME=L,VALUE=300
	PARAM,NAME=DP,VALUE=8
	PARAM,NAME=DIA,VALUE=4
END MACRO
