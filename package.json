{
  "name": "opencnc",
  "productName": "OpenCNC Local Agent",
  "version": "0.2.0",
  "description": "Offline CIX/BPP conversion and guarded Windows workspace automation",
  "author": "OpenCNC contributors",
  "private": true,
  "main": "dist/apps/windows-agent/src/main.js",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsc -b && vite build apps/viewer",
    "test": "vitest run",
    "check": "tsc -b --pretty false",
    "opencnc": "tsx apps/cli/src/index.ts",
    "viewer": "vite apps/viewer --host 127.0.0.1",
    "viewer:open": "vite apps/viewer --host 127.0.0.1 --open",
    "viewer:build": "vite build apps/viewer",
    "agent:compile": "tsc -b && vite build apps/viewer",
    "agent:dev": "pnpm agent:compile && electron .",
    "agent:unpacked": "pnpm agent:compile && electron-builder --dir --publish never",
    "agent:package:win": "pnpm agent:compile && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/wicg-file-system-access": "^2023.10.7",
    "electron": "44.1.0",
    "electron-builder": "26.15.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  }
}
